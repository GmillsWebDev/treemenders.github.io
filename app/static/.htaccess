# Uploaded with the site build. This file REPLACES the server's .htaccess on deploy,
# so any server rules must live here (app/static/.htaccess).

# Serve the SvelteKit-generated error page (src/routes/+error.svelte) for unknown URLs
ErrorDocument 404 /404.html

# One canonical address: https://treemendersarb.co.uk (no www, always HTTPS)
RewriteEngine On
# Leave SSL certificate renewal checks (cPanel AutoSSL / Let's Encrypt) untouched
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://treemendersarb.co.uk/$1 [R=301,L]

# No directory listings
Options -Indexes

# Security headers. No full Content-Security-Policy yet: Font Awesome, GA and Contentsquare would all
# need allow-listing and testing. frame-ancestors on its own only stops other sites framing this one.
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Content-Security-Policy "frame-ancestors 'self'"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=()"
</IfModule>
